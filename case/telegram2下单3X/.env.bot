# ============ TG 频道监听 ============
# ⚠️ 不能沿用旧频道的 session：同一个 auth key 在两处使用，Telegram 会判定
#    AuthKeyDuplicated 并永久作废该 key，两个 bot 一起掉线。
#    第一次运行前必须跑一次：python tg_login.py（会生成 telegram_monitor2.session）
TG_API_ID=30069682
TG_API_HASH=0d169b2953d6fddb1c79a264f910df50
# session 文件名（不含 .session 后缀）—— 必须和旧频道区分开
