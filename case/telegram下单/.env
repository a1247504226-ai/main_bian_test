# ============================================================
# 币安合约推送信号执行器 · 配置模板
# 用法：把下面变量 export 到环境，或用 python-dotenv / systemd EnvironmentFile 加载
# 绝对不要把这份文件（填了真实值后）提交到 git
# ============================================================
# CONFIG = {
#     "TEST": {
#         "BASE_URL": "https://testnet.binancefuture.com",
#         "API_KEY": "riufKUh5kdZNF0eOiHo2eLRPVXOFlPAxbVIdePgK3e0EIbeOmFqGIaryTTT0u9fb",
#         "API_SECRET": "FG6lfFCmNnG0ieStXhQ9QTfaM3ix1Pb5tLksdwvnwq8aUVSinGuzyH6ID2gZJQpO",
#     },
#     "MAIN": {
#         "BASE_URL": "https://fapi.binance.com",
#         "API_KEY": "r7VH9su6ab0QAURp645Dj4jHPtvbNrFRMslM8MvEZRYaQrtwtKIz1ejuyFeu30nL",
#         "API_SECRET": "DJHelGTTbxyOAx4lbtFDDNsscy2ZM0JjEZIsiC40jzXGUDRkIFVsiGEUlolJ0jmG",
#     }
# }

# ---------- 交易所连接 ----------
BINANCE_API_KEY=riufKUh5kdZNF0eOiHo2eLRPVXOFlPAxbVIdePgK3e0EIbeOmFqGIaryTTT0u9fb
BINANCE_API_SECRET=FG6lfFCmNnG0ieStXhQ9QTfaM3ix1Pb5tLksdwvnwq8aUVSinGuzyH6ID2gZJQpO
# MAIN=实盘  TEST=测试网
BINANCE_ENV=TEST
# 1 = 离线模拟（不访问网络），本地演练用
BINANCE_MOCK=0

# ---------- 仓位与风控 ----------
# 每单投入保证金（USDT），名义价值 = 该值 x 杠杆
DEFAULT_MARGIN_USDT=20
DEFAULT_LEVERAGE=10
# 开仓时默认的止盈/止损浮动比例（0.07 = 7%）
DEFAULT_TP_PCT=0.07
DEFAULT_SL_PCT=0.07
# 最大同时持仓数
MAX_POSITIONS=5
# 单笔名义价值上限（USDT），0 = 不限制
MAX_NOTIONAL_USDT=0

# ---------- 多档止盈比例（相对原始仓位）----------
TP1_RATIO=0.50
TP2_RATIO=0.30
TP3_RATIO=0.20

# ---------- 行为开关 ----------
# 信号文件轮询间隔（秒），越小越及时
SIGNAL_POLL_SECONDS=10
# 持仓体检间隔（秒），负责对账与补挂缺失的条件单
SYNC_SECONDS=60
# 自有订单前缀，用于精确识别/撤销自己的单，绝不误伤手动挂单
CLIENT_ID_PREFIX=wbsx
# 交易所上有持仓但本地无记录时，是否接管并补挂保护
ADOPT_UNKNOWN_POSITIONS=1
# 收到反向 OPEN 时是否先平后开
REVERSE_ON_OPPOSITE_OPEN=1
# 是否处理「补仓」信号（默认关闭，涉及加仓风险请自行确认）
# 说明：只有带价格的「补仓：0,01533」/「补仓位：0,482」才会挂单；
#      「预留好补仓位」「留好补仓位」这类纯提示语没有价格，不会被当成下单信号。
ENABLE_ADD=0
# last_tpsl 的保鲜期（秒），超过则开仓用默认 ±7%，避免复用上一单的陈旧值
LAST_TPSL_TTL=120
# 触发价参考：MARK_PRICE（标记价，推荐）或 CONTRACT_PRICE（最新价）
WORKING_TYPE=MARK_PRICE
# 触发保护
PRICE_PROTECT=1
# 止盈止损价格合理性带宽：偏离现价超过该比例的值一律拒绝（0 = 关闭校验）
# 用途：你的推送里有不带币对的 SET_TPSL（如「止盈：1.32-1.39 止损：1.195」），
#      会被广播到所有持仓。若不校验，BTCUSDT 的止损会被换成 1.195 这种永远触发不了的废单。
TPSL_SANITY_PCT=0.5

# 不带币对的 SET_TPSL（如「止盈：1.32-1.39 止损：1.195」，推送里是"引用上一条下单消息"）
# 如何对应到持仓：
#   REF    = 优先用「锚点币对」（见下），该币对无持仓时按开仓价接近度回退（默认）
#   LATEST = 只按开仓时间，取最近开仓的那一笔
#   ALL    = 作用于所有价位匹配的持仓
# 无论哪种模式，都会先过 TPSL_SANITY_PCT 价格闸门，价位对不上的持仓一律不动
SYMBOLLESS_TPSL_MODE=REF

# 哪些消息类型才允许更新「锚点币对」。
# 默认只有 OPEN（下单）——TP / 平仓等消息虽然也带币对，但绝不能让它们把锚点带偏，
# 否则一条「平仓 SOLUSDT」就会让随后的「止盈：…止损：…」找错标的。
# 如果带币对的 SET_TPSL 也算锚点，改成 OPEN,SET_TPSL
SYMBOLLESS_ANCHOR_TYPES=OPEN

# 不带币对的 TP / CLOSE 消息怎么处理。
#   SKIP   = 直接跳过（默认）。真实日志里这类消息绝大多数是营销噪音
#            （「完美止盈，十个点拿下！」「VIP内部群拿下今日止盈第1️⃣单」），
#            且夹在大量无关消息之间，锚点推断不可靠。平错仓的代价远大于漏平。
#   ANCHOR = 用锚点币对推断（仅在确认这类消息确实指向上一单时开启）
SYMBOLLESS_TP_CLOSE_MODE=SKIP

# 是否处理「出补仓」消息（撤销之前挂出的补仓挂单）
ENABLE_CANCEL_ADD=1

# ---------- 文件位置 ----------
# 数据目录（日志 / 状态文件都放这里）
DATA_DIR=
# 信号文件路径（你的 Telegram 解析程序往这里追加 JSONL）
SIGNAL_FILE=

# ---------- 邮件通知 ----------
EMAIL_ENABLED=1
MONITOR_EMAIL_FROM=xxx@163.com
MONITOR_EMAIL_TO=xxx@qq.com
# 163 邮箱填「SMTP 授权码」，不是网页登录密码
MONITOR_EMAIL_PASSWORD=
MONITOR_EMAIL_SERVER=smtp.163.com
MONITOR_EMAIL_PORT=465
# 同一类通知的冷却时间（秒），防止刷屏
NOTIFY_COOLDOWN_SECONDS=120

# ---------- 日志 ----------
LOG_LEVEL=INFO
