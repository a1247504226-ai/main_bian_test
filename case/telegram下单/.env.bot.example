# 复制成 .env.bot 并填入真实值
# 权限只勾「读取」+「合约交易」，绝对不要勾提现
# 并绑定 VPS 公网 IP 白名单

BINANCE_API_KEY=
BINANCE_API_SECRET=

# ============ 主网密钥（切主网才需要，和测试网是两套 key）============
# 默认用上面的测试网 key，加 --mainnet 才会用这两个
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=

# ============ 邮件通知（余额跨档提醒）============
# 163 邮箱必须用「授权码」而不是登录密码
# 获取：163 邮箱设置 → POP3/SMTP/IMAP → 开启 SMTP → 生成授权码
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
SMTP_USER=your_account@163.com
SMTP_PASSWORD=your_auth_code
SMTP_TO=your_target@qq.com
SMTP_MAX_RETRIES=3
# 余额超过 2000 开始提醒，之后每跨 2000 再提醒一次
BALANCE_ALERT_THRESHOLD=2000
BALANCE_ALERT_STEP=2000

# ============ Telegram 告警（可选但强烈建议）============
# 找 @BotFather 建 bot 拿 token
# chat_id 可以通过 https://api.telegram.org/bot<TOKEN>/getUpdates 查
TG_TOKEN=
TG_CHAT_ID=

# ============ TG 频道监听（自动跟单必填）============
# 手机登录 https://my.telegram.org → API development tools → 创建应用
TG_API_ID=
TG_API_HASH=
# 你的 TG 手机号，带国家码
TG_PHONE=+8613800138000
# 要监听的频道：@用户名 / https://t.me/xxx / -1001234567890
TG_CHANNEL=
